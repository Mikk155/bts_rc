
{
    "version": "2.0.0",
    "tasks":
    [
        {
            "label": "Website compile & test",
            "dependsOn": [ "Website dev server", "Website bundle (watch)" ],
            "dependsOrder": "parallel",
            "group":
            {
                "kind": "build",
                "isDefault": true
            },
            "presentation":
            {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Website dev server",
            "type": "shell",
            "command": "npm.cmd",
            "args":
            [
                "run",
                "dev"
            ],
            "options":
            {
                "cwd": "${workspaceFolder}/src/docs"
            },
            "isBackground": true,
            "presentation":
            {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "Website bundle (watch)",
            "type": "shell",
            "command": "npm.cmd",
            "args": ["run", "build:watch"],
            "options": {
                "cwd": "${workspaceFolder}/src/docs"
            },
            "isBackground": true,
            "presentation":
            {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "Format & check AngelScript files.",
            "type": "shell",
            "command": "python",
            "args":
            [
                "src/main.py"
            ],
            "group":
            {
                "kind": "build",
                "isDefault": true
            },
            "presentation":
            {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Release Test.",
            "type": "shell",
            "command": "python",
            "args":
            [
                "src/main.py",
                "--release",
                "--test"
            ],
            "group":
            {
                "kind": "build",
                "isDefault": true
            },
            "presentation":
            {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}
