{
    "files.associations":
    {
        // We allow comments in AngelScript json
        "*.json": "jsonc",
        "*.as": "angelscript",
        "*.predefined": "angelscript"
    },

    "files.exclude":
    {
        "**/.git": true,
        "**/__pycache__/**": true,
        "**/node_modules/**": true,
        "maps/soundcache/**": true,
        "src/maps/**": true,
        "Rubbish/tmp/**": true,
        "desktop.ini": true
    },

    "editor.indentSize": 4,
    "editor.trimAutoWhitespace": true,
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,
    "files.trimFinalNewlines": true,
    "editor.formatOnType": true,

    "[angelscript]":
    {
        "files.encoding": "utf8"
    },
    "[typescript]":
    {
        "editor.formatOnType": false,
        "editor.formatOnSave": false
    },
    "[javascript]":
    {
        "editor.formatOnType": false,
        "editor.formatOnSave": false
    },
    "[jsonc]":
    {
        "editor.formatOnType": false,
        "editor.formatOnSave": false
    },

    "angelscript.predefined.active": "${workspaceFolder}/as.predefined",
    "angelscript.define": [
        "SERVER",
        "EDITOR_ONLY",
        "METAMOD_PLUGIN_ASLP"
    ],
    "angelscript.engine.alwaysImplDefaultConstruct": true,
    "angelscript.include.implicitExtension": true,
    "angelscript.modules": [
        {
            "name": "bts_rc",
            "entry": "${workspaceFolder}/scripts/maps/bts_rc/main.as"
        }
    ],
    "angelscript.dimInactiveRegions": true,
    "angelscript.diagnostics.reportAccessorPortability": true,
    "angelscript.engine.disableIntegerDivision": true,
    "angelscript.engine.disallowEmptyListElements": true,
    "angelscript.preprocessor.pragmaMode": "error",
    "angelscript.statusBar.alignment": "right",
    "angelscript.diagnostics.reportPossibleNullDereference": false,
    "angelscript.features.formatting": false,
    "angelscript.features.onTypeFormatting": false
}
