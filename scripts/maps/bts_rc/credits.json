// This file is parsed using json V1 which has a issue with numbers.
// Variables supposed to be float are required to explicitly set decimals!
{
    // Time to take before credits roll out (Uses a fade in and out according to this variable * 2 + (1.0 hold time ))
    "fadetime": 2.0, // In this example it takes 5 seconds in total with fading but only 4 (fadetime * 2) to fire target (see bellow)

    // Fires this target after the bellow delay.
    "target": "start_camera",
    "delay": 2.0,

    // Most variables are stored for the next caption until they are explicitly re-defined.
    // Only variables that are not stored are "message", "target" and "delay". they're cleared every new entry.
    // And parameters x, holdtime, y and fadein if scroll is true since they're dynamically updated.
    "captions":
    [
        {
            // scroll: false means this is a standar game_text style message
            // The next caption will play after fadein + fadeout + fadehold ends.
            "scroll": false,
            // These next variables are used only on non-scroll captions.
            "x": -1.0,
            // Remember decimals are important to retrieve "float"
            "y": -1.0,
            "fadeintime": 1.0,
            "fadeouttime": 1.0,
            "holdtime": 3.0,
            "fxtime": 1.0,
            // Except effect it is integer.
