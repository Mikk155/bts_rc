@SolidClass base(Mandatory, ZHLT) = trigger_logger: "Fast message displayer"
[
    message(string) : "Message to display"
]

@PointClass base(Mandatory) = info_section : "Section teleporter"
[
    message(string) : "Section title"
    netname(choices) : "Color" : "<w>" =
    [
        "<w>" : "white"
        "<d>" : "gray"
        "<y>" : "yellow"
        "<r>" : "red"
        "<m>" : "magenta"
        "<g>" : "green"
        "<o>" : "orange"
        "<c>" : "cyan"
    ]
    target(target_destination) : "Target on selected"
]

@PointClass base(Mandatory) = entitymaker : "Squadmaker sucks ass lol"
[
    +classname(string) : "Child classname"
    +targetname(string) : "Child targetname"
    target(string) : "Child target"
    -target(string) : "Fire after spawn"
    -mode(choices) : "Mode" : "0" =
    [
        0 : "Trigger"
        1 : "Think"
    ]
    -starton(choices) : "Start on" : "0" =
    [
        0 : "No"
        1 : "Yes"
    ]
]
